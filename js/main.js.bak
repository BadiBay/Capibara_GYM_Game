    /* ═══════════════════════════════════════════════════════
       ASSETS
       ═══════════════════════════════════════════════════════ */
    const CAPY_IMAGES = {
      1: { body: new Image(), head: new Image(), armL: new Image(), armR: new Image() },
      2: { body: new Image(), head: new Image(), armL: new Image(), armR: new Image() },
      3: { body: new Image(), head: new Image(), armL: new Image(), armR: new Image() },
      4: { body: new Image(), head: new Image(), armL: new Image(), armR: new Image() },
      5: { body: new Image(), head: new Image(), armL: new Image(), armR: new Image(), bg: new Image() }
    };

    const tiersStr = ['noodles', 'noob', 'jock', 'gigachad', 'god'];
    for (let i = 0; i < 5; i++) {
      let t = i + 1;
      CAPY_IMAGES[t].body.src = `${tiersStr[i]}_body.png`;
      CAPY_IMAGES[t].head.src = `${tiersStr[i]}_head.png`;
      CAPY_IMAGES[t].armL.src = `${tiersStr[i]}_arm_left.png`;
      CAPY_IMAGES[t].armR.src = `${tiersStr[i]}_arm_right.png`;
    }
    CAPY_IMAGES[5].bg.src = 'god_bg.webp';

    /* ═══════════════════════════════════════════════════════
       YANDEX GAMES SDK
       ═══════════════════════════════════════════════════════ */
    let ysdk = null;
    let player = null;
    let leaderboards = null;
    let lastAdTime = 0;

    function showInterstitialAd() {
      if (ysdk && ysdk.adv) {
        const now = Date.now();
        if (now - lastAdTime > 3 * 60 * 1000) { // 3 min cooldown
          ysdk.adv.showFullscreenAdv({
            callbacks: {
              onClose: function (wasShown) { lastAdTime = Date.now(); },
              onError: function (error) { }
            }
          });
        }
      }
    }

    function initYandexSDK() {
      if (typeof YaGames !== 'undefined') {
        YaGames.init().then(res => {
          ysdk = res;
          ysdk.features.LoadingAPI?.ready();

          // Show rewarded btn if available
          document.getElementById('rewarded-ad-btn').style.display = 'block';

          // Show first ad
          setTimeout(() => showInterstitialAd(), 2000);

          ysdk.getPlayer().then(_player => {
            player = _player;
            loadGame(); // Reload from cloud if available
          }).catch(err => {
            console.error('Player error:', err);
          });

          if (ysdk.leaderboards) {
            leaderboards = ysdk.leaderboards;
          } else {
            // Fallback для старых версий SDK
            ysdk.getLeaderboards?.().then(_lb => {
              leaderboards = _lb;
            }).catch(err => console.error('Leaderboard error:', err));
          }

        }).catch(e => {
          console.error('Yandex SDK Init Error', e);
        });
      } else {
        console.log('Running locally without Yandex SDK');
      }
    }

    /* ═══════════════════════════════════════════════════════
       LOCATIONS
       ═══════════════════════════════════════════════════════ */
    const LOCATIONS = [
      { id: 'basement', name: 'Подвал', desc: 'Сыро, но здесь закаляется сталь.', multiplier: 1, reqTier: 1, bgImage: 'url("подвал.webp")' },
      { id: 'elite', name: 'Элитный Фитнес', desc: 'Дорогие тренажеры, гламурные девчонки. x5 GP', multiplier: 5, reqTier: 3, bgImage: 'url("элитный зал.webp")' },
      { id: 'beach', name: 'Пляж Майами', desc: 'Качайся под солнцем. x25 GP', multiplier: 25, reqTier: 4, bgImage: 'url("маями.webp")' },
      { id: 'space', name: 'Качалка на Марсе', desc: 'Гравитация для слабаков. x100 GP', multiplier: 100, reqTier: 5, bgImage: 'url("марс.webp")' },
    ];

    /* ═══════════════════════════════════════════════════════
       BOSSES (TOURNAMENTS)
       ═══════════════════════════════════════════════════════ */
    const BOSSES = [
      { level: 1, name: 'Гусь-Задира', hp: 5000, reward: 10 },
      { level: 2, name: 'Альфа-Кенгуру', hp: 250000, reward: 25 },
      { level: 3, name: 'Крокодил-Качок', hp: 15000000, reward: 50 },
      { level: 4, name: 'Медведь-Бодибилдер', hp: 1000000000, reward: 100 },
      { level: 5, name: 'Гигачад-Кот', hp: 50000000000, reward: 500 },
    ];
    let currentTournament = null;

    function getLocationMultiplier() {
      const loc = LOCATIONS.find(l => l.id === (state.currentLocation || 'basement'));
      return loc ? loc.multiplier : 1;
    }

    /* ═══════════════════════════════════════════════════════
       GAME STATE
       ═══════════════════════════════════════════════════════ */
    let state = {
      gpCount: 0,
      clickPower: 1,
      autoPower: 0,
      capyMassLevel: 1,
      clickLevel: 0,
      titaniumLevel: 0,
      alienLevel: 0,
      neutronLevel: 0,
      autoLevel: 0,
