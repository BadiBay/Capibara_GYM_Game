      broLevel: 0,
      trainerLevel: 0,
      sponsorLevel: 0,
      chainLevel: 0,
      // costs scale ×1.15 to ×1.5 per level
      clickCost: 10,
      titaniumCost: 5000,
      alienCost: 100000,
      neutronCost: 5000000,
      autoCost: 50,
      shakeCost: 100,
      broCost: 1000,
      trainerCost: 10000,
      sponsorCost: 250000,
      chainCost: 10000000,
      creatineLevel: 0,
      creatineCost: 200,
      pelicanLevel: 0,
      pelicanCost: 500,
      steroidsUnlocked: false,
      steroidsCost: 1000,
      steroidsActiveUntil: 0,
      steroidsCooldownUntil: 0,
      prestigeCoins: 0,
      lastSaveTime: Date.now(),
      soundEnabled: true,
      totalClicks: 0,
      totalGPEarned: 0,
      totalPrestiges: 0,
      goldenDumbbellsClicked: 0,
      playStartTime: Date.now(),
      unlockedAchievements: [],
      // combo system
      comboClicks: 0,
      comboResetTime: 0,
