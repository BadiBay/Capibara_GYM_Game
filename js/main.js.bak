    const $lvlTitanium = document.getElementById('lvl-titanium');
    const $lvlAlien = document.getElementById('lvl-alien');
    const $lvlNeutron = document.getElementById('lvl-neutron');
    const $lvlAuto = document.getElementById('lvl-auto');
    const $lvlShake = document.getElementById('lvl-shake');
    const $lvlBro = document.getElementById('lvl-bro');
    const $lvlTrainer = document.getElementById('lvl-trainer');
    const $lvlSponsor = document.getElementById('lvl-sponsor');
    const $lvlChain = document.getElementById('lvl-chain');
    const $buyCreatine = document.getElementById('buy-creatine');
    const $buyPelican = document.getElementById('buy-pelican');
    const $buySteroids = document.getElementById('buy-steroids');
    const $costCreatine = document.getElementById('cost-creatine');
    const $costPelican = document.getElementById('cost-pelican');
    const $costSteroids = document.getElementById('cost-steroids');
    const $lvlCreatine = document.getElementById('lvl-creatine');
    const $lvlPelican = document.getElementById('lvl-pelican');
    const $lvlSteroids = document.getElementById('lvl-steroids');
    const $statClick = document.getElementById('stat-click');
    const $statAuto = document.getElementById('stat-auto');
    const $statTier = document.getElementById('stat-tier');
    const $tierBanner = document.getElementById('tier-banner');
