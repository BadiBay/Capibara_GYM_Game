      // events
      activeEvent: null,
      activeEventUntil: 0,
      // prestige tree
      prestigeUpgrades: {},
      tutorialStep: 0,
      // Phase 10: Gems, Quests, Skins
      gems: 0,
      activeQuests: [],
      questsCompleted: 0,
      skins: [],
      activeSkin: null,
      retroGemsGiven: false,
      currentLocation: 'basement',
      tournamentLevel: 1,
      tournamentCooldownUntil: 0,
      lootboxBuffUntil: 0,
      lootboxBuffMultiplier: 1,
      // animation
      squeezeT: 0,
      liftAngle: 0,
    };

    function saveGame() {
      state.lastSaveTime = Date.now();
      const dataString = JSON.stringify(state);
      localStorage.setItem('capybaraSave', dataString);

      if (player) {
        // Convert state to a flat object format if needed, but Yandex allows nested objects if stringified or just object
        player.setData(state).then(() => {
          // Saved to cloud
        }).catch(() => { });
      }

      // Submit score to leaderboard
      if (leaderboards && state.totalGPEarned) {
        leaderboards.setLeaderboardScore('top_capybara', Math.floor(state.totalGPEarned)).catch(() => { });
      }
    }

    function processSaveData(parsed) {
      try {
        state = { ...state, ...parsed };

        // Daily Login Logic
        const nowRaw = new Date();
        const localDate = nowRaw.getFullYear() + '-' + String(nowRaw.getMonth() + 1).padStart(2, '0') + '-' + String(nowRaw.getDate()).padStart(2, '0');

        if (state.lastLoginDate !== localDate) {
          if (state.lastLoginDate) {
            const lastRaw = new Date(state.lastLoginDate);
            const diffTime = Math.abs(nowRaw - lastRaw);
            const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

            if (diffDays > 1) {
              state.loginStreak = 0; // reset streak if missed a day
            }
          }
          state.dailyRewardClaimed = false;
          state.lastLoginDate = localDate;
        }

        // Offline earnings calculation
        const now = Date.now();
        const secondsOffline = Math.floor((now - state.lastSaveTime) / 1000);
        if (secondsOffline > 10 && state.autoPower > 0) {
          let mult = 0.2;
          if (state.prestigeUpgrades && state.prestigeUpgrades['offline_god']) mult = 1.0;
          const earned = Math.floor(secondsOffline * state.autoPower * mult);
          state.gpCount += earned;

          const $modal = document.getElementById('offline-modal');
          if ($modal) {
            $modal.innerHTML = `С возвращением, бро!<br>Твоя капибара качалась, пока ты спал.<br>+${formatNum(earned)} GP`;
            $modal.classList.add('show');
            setTimeout(() => $modal.classList.remove('show'), 5000);
          }
        }

        // Retroactive Gems for already completed achievements
        if (!state.retroGemsGiven) {
          if (state.unlockedAchievements && state.unlockedAchievements.length > 0) {
            state.gems = (state.gems || 0) + state.unlockedAchievements.length;
          }
          state.retroGemsGiven = true;
        }

        // Fix english quests
        if (state.activeQuests && state.activeQuests.some(q => q.desc.match(/[a-zA-Z]/))) {
          state.activeQuests = [];
        }

        // Fix totalGPEarned if corrupted
        if (isNaN(state.totalGPEarned) || state.totalGPEarned == null) {
          state.totalGPEarned = 0;
        }

        state.lastSaveTime = Date.now();
      } catch (e) {
        console.error('Save file corrupted', e);
      }
    }

    function loadGame() {
      if (player) {
        player.getData().then(data => {
          if (Object.keys(data).length > 0) {
            processSaveData(data);
          } else {
            loadFromLocal();
          }
        }).catch(() => loadFromLocal());
      } else {
        loadFromLocal();
      }
    }

    function loadFromLocal() {
      const saved = localStorage.getItem('capybaraSave');
      if (saved) {
        processSaveData(JSON.parse(saved));
      }
    }

    loadGame();
    initYandexSDK();
    setInterval(saveGame, 10000); // Save every 10s to not spam Yandex API
    window.addEventListener('beforeunload', saveGame);

    /* ═══════════════════════════════════════════════════════
       NUMBER FORMATTING
       ═══════════════════════════════════════════════════════ */
    const SUFFIXES = ['', 'K', 'M', 'B', 'T', 'Qa', 'Qi', 'Sx', 'Sp', 'Oc', 'No', 'Dc'];
    function formatNum(n) {
      if (n < 0) return '-' + formatNum(-n);
      if (n < 1000) return Math.floor(n).toString();
      let tier = Math.floor(Math.log10(n) / 3);
      if (tier >= SUFFIXES.length) tier = SUFFIXES.length - 1;
      const scaled = n / Math.pow(10, tier * 3);
      return (scaled >= 100 ? Math.floor(scaled) : scaled.toFixed(1)) + SUFFIXES[tier];
    }


    /* ─── Shop Filters ──────────────────────────────────── */
    function filterShop(category) {
      const clickItems = ['card-click', 'card-titanium', 'card-alien', 'card-neutron'];
      const autoItems = ['card-auto', 'card-shake', 'card-bro', 'card-trainer', 'card-sponsor', 'card-chain'];
      const specialItems = ['card-creatine', 'card-pelican', 'card-steroids'];

      document.querySelectorAll('.filter-btn').forEach(b => b.classList.toggle('active', b.dataset.filter === category));
      document.querySelectorAll('.shop-card').forEach(card => {
        if (card.id === 'card-prestige') return;

        let isMatch = false;
        if (category === 'all') isMatch = true;
        else if (category === 'click' && clickItems.includes(card.id)) isMatch = true;
        else if (category === 'auto' && autoItems.includes(card.id)) isMatch = true;
        else if (category === 'special' && specialItems.includes(card.id)) isMatch = true;

        card.classList.toggle('hidden-by-filter', !isMatch);
      });
    }

    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => filterShop(btn.dataset.filter));
    });

    /* ─── Tier definitions ──────────────────────────────── */
    const ACHIEVEMENTS = [
      { id: 'first_blood', name: 'Первая Кровь', desc: 'Сделай первый клик.', icon: '💪', check: s => s.totalClicks >= 1 },
      { id: 'maniac', name: 'Клик-Маньяк', desc: 'Кликни 1,000 раз.', icon: '⚡', check: s => s.totalClicks >= 1000 },
      { id: 'passive', name: 'Пассивный Доход', desc: 'Достигни 1,000 Авто GP/с.', icon: '📈', check: s => s.autoPower >= 1000 },
      { id: 'golden_touch', name: 'Золотое Касание', desc: 'Слови 5 Золотых Гантелей.', icon: '✨', check: s => s.goldenDumbbellsClicked >= 5 },
      { id: 'gigachad', name: 'ГИГАЧАД', desc: 'Достигни Уровня Массы 4.', icon: '🗿', check: s => s.capyMassLevel >= 4 },
      { id: 'olympus', name: 'Капи-Бог', desc: 'Достигни Уровня Массы 5.', icon: '👼', check: s => s.capyMassLevel >= 5 },
      { id: 'prestige', name: 'Золотой Век', desc: 'Сделай Престиж в первый раз.', icon: '🌟', check: s => s.prestigeCoins >= 1 },
    ];

    function checkAchievements() {
      let newUnlocked = false;
      ACHIEVEMENTS.forEach(ach => {
        if (!state.unlockedAchievements.includes(ach.id)) {
          if (ach.check(state)) {
            state.unlockedAchievements.push(ach.id);
            state.gems = (state.gems || 0) + 1; // +1 Gem
            showToast(`🏆 Открыто: ${ach.name}! (+1% к GP & 1 💎)`);
            spawnConfetti();
            beep(500, 0.1); setTimeout(() => beep(700, 0.3), 150);
            newUnlocked = true;
          }
        }
      });
      if (newUnlocked) {
        saveGame();
        renderAchievements();
        updateUI();
      }
    }

    function showToast(text) {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'toast';
      toast.textContent = text;
      container.appendChild(toast);
      setTimeout(() => toast.remove(), 5000);
    }

    function renderStats() {
      const $list = document.getElementById('stats-list');
      const timePlayed = Math.floor((Date.now() - state.playStartTime) / 1000);
      const m = Math.floor(timePlayed / 60);
      const s = timePlayed % 60;

      $list.innerHTML = `
        <div style="margin-bottom:12px; font-size:1.1rem; color:var(--neon-blue);">
          Времени в игре: <b>${m}м ${s}с</b>
        </div>
        <div style="margin-bottom:12px; font-size:1.1rem; color:var(--gold);">
          Всего заработано GP: <b>${formatNum(state.totalGPEarned || 0)}</b>
        </div>
        <div style="margin-bottom:12px; font-size:1.1rem;">
          Сделано кликов: <b>${formatNum(state.totalClicks || 0)}</b>
        </div>
        <div style="margin-bottom:12px; font-size:1.1rem; color:#ffbc00;">
          Золотых гантелей: <b>${state.goldenDumbbellsClicked || 0}</b>
        </div>
        <div style="margin-bottom:12px; font-size:1.1rem; color:var(--neon-pink);">
          Сделано престижей: <b>${state.totalPrestiges || 0}</b>
        </div>
        <div style="margin-bottom:12px; font-size:1.1rem;">
          Уровень массы: <b>${state.capyMassLevel}</b>
        </div>
      `;
    }

    function renderAchievements() {
      const list = document.getElementById('achievements-list');
      if (!list) return;
      list.innerHTML = '';
      ACHIEVEMENTS.forEach(ach => {
        const isUnlocked = state.unlockedAchievements.includes(ach.id);
        list.innerHTML += `
      <div class="ach-item ${isUnlocked ? 'unlocked' : ''}">
        <div class="ach-icon">${isUnlocked ? ach.icon : '❓'}</div>
        <div class="ach-info">
          <h4>${isUnlocked ? ach.name : '???'}</h4>
          <p>${isUnlocked ? ach.desc : 'Играй, чтобы открыть'}</p>
        </div>
      </div>
    `;
      });
    }

    /* ─── Tier definitions ──────────────────────────────── */
    const TIERS = [
      { level: 1, name: 'РУКИ-МАКАРОНИНЫ', color: '#ff6b6b', gpNeeded: 0 },
      { level: 2, name: 'НОВИЧОК', color: '#ffa502', gpNeeded: 50 },
      { level: 3, name: 'КАЧОК-КАПИ', color: '#ff2eaa', gpNeeded: 500 },
      { level: 4, name: 'ГИГАЧАД', color: '#00e5ff', gpNeeded: 5000 },
      { level: 5, name: 'КАПИ-БОГ', color: '#ffd700', gpNeeded: 50000 },
    ];

    /* ═══════════════════════════════════════════════════════
       AUDIO — tiny Web Audio beep
       ═══════════════════════════════════════════════════════ */
    let audioCtx = null;
    function beep(freq = 220, dur = 0.06) {
      if (!state.soundEnabled) return;
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'triangle';
        osc.frequency.value = freq;
        gain.gain.setValueAtTime(0.18, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
        osc.connect(gain).connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + dur);
      } catch (_) { }
    }
    function purchaseBeep() { beep(440, 0.08); setTimeout(() => beep(660, 0.08), 80); }

    /* ═══════════════════════════════════════════════════════
       DOM REFS
       ═══════════════════════════════════════════════════════ */
    const $gpCount = document.getElementById('gp-count');
